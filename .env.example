# NGBSE 20.2 Environment Variables
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# COLLECTOR API CREDENTIALS
# =============================================================================

# Shodan API
SHODAN_API_KEY=your_shodan_api_key_here

# Censys API
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# LeakIX API
LEAKIX_API_KEY=your_leakix_api_key_here

# URLScan.io API
URLSCAN_API_KEY=your_urlscan_api_key_here

# GitHub API (for repository scanning)
GITHUB_TOKEN=your_github_token_here

# News API (for threat intelligence feeds)
NEWS_API_KEY=your_news_api_key_here

# =============================================================================
# LLM API CREDENTIALS (for BALLM)
# =============================================================================

# OpenAI API (for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# CONFIGURATION
# =============================================================================

# Output directory for results
NGBSE_OUTPUT_DIR=out

# Scenario synthesis mode (none, basic, advanced)
NGBSE_SCENARIO_MODE=none

# Brief synthesis mode (none, basic, advanced)
NGBSE_BRIEF_MODE=none

# Log level (DEBUG, INFO, WARNING, ERROR)
NGBSE_LOG_LEVEL=INFO

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Enable/disable specific collectors
NGBSE_ENABLE_HTTP_WEB=true
NGBSE_ENABLE_SHODAN=true
NGBSE_ENABLE_CENSYS=true
NGBSE_ENABLE_LEAKIX=true
NGBSE_ENABLE_URLSCAN=true
NGBSE_ENABLE_GITHUB=true
NGBSE_ENABLE_NEWS=true

# Rate limiting (requests per minute)
NGBSE_RATE_LIMIT=60

# Timeout settings (seconds)
NGBSE_REQUEST_TIMEOUT=30
NGBSE_COLLECTION_TIMEOUT=300

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug mode
NGBSE_DEBUG=false

# Enable verbose logging
NGBSE_VERBOSE=false

# Test mode (uses mock data)
NGBSE_TEST_MODE=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit this file with real credentials
# 2. Use strong, unique API keys for each service
# 3. Rotate credentials regularly
# 4. Monitor API usage and costs
# 5. Some APIs have rate limits - adjust NGBSE_RATE_LIMIT accordingly
# 6. For production, use a proper secret management system