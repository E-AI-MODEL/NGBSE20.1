# NGBSE 20.3 Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# API CREDENTIALS
# =============================================================================

# Shodan API Key (https://account.shodan.io/)
SHODAN_API_KEY=your_shodan_api_key_here

# Censys API Credentials (https://censys.io/account/api)
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# LeakIX API Key (https://leakix.net/api)
LEAKIX_API_KEY=your_leakix_api_key_here

# URLScan API Key (https://urlscan.io/user/signup/)
URLSCAN_API_KEY=your_urlscan_api_key_here

# GitHub Token (https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# News API Key (https://newsapi.org/register)
NEWS_API_KEY=your_news_api_key_here

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere API Key (https://dashboard.cohere.ai/api-keys)
COHERE_API_KEY=your_cohere_api_key_here

# Google AI API Key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# LLM MODEL PREFERENCES (Optional)
# =============================================================================

# Preferred model for OpenAI (gpt-4, gpt-3.5-turbo, gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Preferred model for Azure OpenAI (gpt-4, gpt-3.5-turbo)
AZURE_OPENAI_MODEL=gpt-4

# Preferred model for Anthropic (claude-3.5-sonnet, claude-3-haiku)
ANTHROPIC_MODEL=claude-3.5-sonnet

# Preferred model for Cohere (command, command-light)
COHERE_MODEL=command

# Preferred model for Google (gemini-pro, gemini-pro-vision)
GOOGLE_MODEL=gemini-pro

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Paths (relative to container)
SEEDS_PATH=config/seeds.jsonl
RULES_PATH=config/rules.json
OUT_DIR=out

# Domain allowlist (comma-separated, use * for all)
ALLOWLIST=*

# Logging level
LOG_LEVEL=INFO

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Compose project name
COMPOSE_PROJECT_NAME=ngbse20

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. Never commit .env files to version control
# 2. Use strong, unique API keys for each service
# 3. Regularly rotate your API keys
# 4. Monitor API usage and set appropriate limits
# 5. Use environment-specific configurations for different deployments
#
# =============================================================================