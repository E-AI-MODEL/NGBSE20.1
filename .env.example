# NGBSE 20.1 Environment Configuration
# Copy this file to .env and fill in your API keys

# Logging Configuration
NGBSE_LOG_LEVEL=INFO

# LLM API Keys (configure at least one for BALLM functionality)
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://...
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Google
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-1.5-pro

# LLM Modes (set to "api" to enable LLM calls, "prompt" to generate prompts)
NGBSE_BRIEF_MODE=api
NGBSE_SCENARIO_MODE=api

# Note: Only the LLM providers you configure will be used.
# The system will automatically fall back to available providers.
