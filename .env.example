# NGBSE 20.1 Environment Configuration
# Copy this file to .env and fill in your API keys

# Logging Configuration
NGBSE_LOG_LEVEL=INFO

# LLM API Keys (configure at least one for BALLM functionality)
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://...
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Google
GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-1.5-pro

# LLM Modes (set to "api" to enable LLM calls, "prompt" to generate prompts)
NGBSE_BRIEF_MODE=api
NGBSE_SCENARIO_MODE=api

# OSINT Collector API Keys
# LeakIX - Data breach intelligence
LEAKIX_API_KEY=...

# Shodan - IoT and infrastructure intelligence
SHODAN_API_KEY=...

# Censys - Network and SSL intelligence
CENSYS_API_ID=...
CENSYS_API_SECRET=...

# URLScan - Threat intelligence
URLSCAN_API_KEY=...

# GitHub - Code repository intelligence
GITHUB_TOKEN=...

# News APIs - Recent developments and threat intelligence
NEWS_API_KEY=...  # NewsAPI.org
GNEWS_API_KEY=... # GNews (backup)

# Note: Only the collectors you configure will be used.
# The system will automatically fall back to available collectors.
# For production use, configure at least 3-4 collectors for comprehensive coverage.
